generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USERS & AUTHENTICATION
// ==========================================

model User {
  id        String  @id @default(cuid())
  email     String? @unique // Optional for phone-first BD registration
  phone     String  @unique // Primary login identifier in Bangladesh
  password  String
  name      String
  role      Role    @default(CUSTOMER)
  isActive  Boolean @default(true)

  store             Store?             @relation("StoreOwner")
  cart              Cart?
  orderGroups       OrderGroup[]       @relation("CustomerOrderGroups")
  orders            Order[]            @relation("CustomerOrders")
  verifiedPayments  Payment[]          @relation("PaymentVerifier")
  reviews           Review[]           @relation("CustomerReviews")
  addresses         UserAddress[]      @relation("CustomerAddresses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
  @@map("users")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

// ==========================================
// CUSTOMER ADDRESS BOOK
// ==========================================

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("CustomerAddresses", fields: [userId], references: [id], onDelete: Cascade)

  fullName     String
  phoneNumber  String
  district     String   // e.g. "Dhaka", "Chattogram"
  thana        String   // e.g. "Mirpur", "Panchlaish"
  streetAddress String
  isDefault    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, isDefault])
  @@map("user_addresses")
}

// ==========================================
// STORES & SELLER SUBSCRIPTIONS
// ==========================================

model Store {
  id          String      @id @default(cuid())
  sellerId    String      @unique
  seller      User        @relation("StoreOwner", fields: [sellerId], references: [id], onDelete: Restrict)

  slug        String      @unique
  displayName String
  description String?

  logoUrl     String?
  bannerUrl   String?
  primaryColor String?

  seoTitle       String?
  seoDescription String?

  status      StoreStatus @default(DRAFT)
  isPublished Boolean     @default(false)
  publishedAt DateTime?

  // Strict PREMILY official or approved partner flag (Admin-only controlled)
  isPremilyMart       Boolean                 @default(false)

  // Seller verification status
  verificationStatus  StoreVerificationStatus @default(UNVERIFIED)
  verifiedAt          DateTime?
  verifiedBy          String?
  tradeLicenseNo      String?
  nidNumber           String?
  verificationNote    String?

  // Store-specific shipping rate overrides
  insideDistrictCost  Decimal?                @db.Decimal(10, 2) // Custom rate for seller's local district
  outsideDistrictCost Decimal?                @db.Decimal(10, 2) // Custom rate for outside districts
  homeDistrict        String?                                    // Seller's base district (e.g. "Chattogram")

  products      Product[]
  orders        Order[]
  subscription  SellerSubscription?
  shippingRates StoreShippingRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isPublished])
  @@index([isPremilyMart])
  @@index([verificationStatus])
  @@map("stores")
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum StoreVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model StoreShippingRate {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  districtName String   // Specific district (e.g. "Sylhet")
  rate         Decimal  @db.Decimal(10, 2)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, districtName])
  @@map("store_shipping_rates")
}

// ==========================================
// NATIONWIDE LOGISTICS (DEFAULT DISTRICT RATES)
// ==========================================

model DistrictShipping {
  id               String       @id @default(cuid())
  districtName     String       @unique // e.g. "Dhaka", "Chattogram"
  division         String               // e.g. "Dhaka", "Chittagong"
  zone             ShippingZone @default(OUTSIDE_DHAKA)
  baseCost         Decimal      @default(150.00) @db.Decimal(10, 2)
  estimatedDaysMin Int          @default(3)
  estimatedDaysMax Int          @default(5)
  isActive         Boolean      @default(true)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("district_shipping")
}

enum ShippingZone {
  INSIDE_DHAKA
  DHAKA_SUBURB
  OUTSIDE_DHAKA
}

model SellerSubscription {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  planCode String  @default("seller_monthly")
  amount   Decimal @default(150.00) @db.Decimal(10, 2)
  currency String  @default("BDT")

  status SubscriptionStatus @default(TRIALING)

  trialStartsAt      DateTime  @default(now())
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String? @unique

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentPeriodEnd])
  @@map("seller_subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model SubscriptionPayment {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   SellerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  amount   Decimal                   @db.Decimal(10, 2)
  currency String                    @default("BDT")
  status   SubscriptionPaymentStatus @default(PENDING)

  provider              String?
  providerTransactionId String? @unique

  periodStart   DateTime?
  periodEnd     DateTime?
  paidAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
  @@map("subscription_payments")
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ==========================================
// CATEGORIES, PRODUCTS & INVENTORY
// ==========================================

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String
  imageUrl  String?
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("SubCategories")
  products  Product[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)

  name        String
  slug        String
  description String

  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  status      ProductStatus @default(DRAFT)

  seoTitle       String?
  seoDescription String?

  // High-performance cached stats for fast public discovery
  avgRating      Decimal       @default(0.00) @db.Decimal(3, 2)
  reviewCount    Int           @default(0)
  salesCount     Int           @default(0)
  isFeatured     Boolean       @default(false)
  isTrending     Boolean       @default(false)

  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]
  campaignItems  CampaignProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@index([categoryId])
  @@index([status, isFeatured])
  @@index([status, salesCount])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id             String   @id @default(cuid())
  sku            String   @unique
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // Strikethrough original price (MSRP)
  stock          Int      @default(0)
  size           String?
  color          String?
  isActive       Boolean  @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  position  Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

// ==========================================
// CAMPAIGNS, PROMOTIONS & FLASH SALES
// ==========================================

model Campaign {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  bannerUrl   String?
  badgeText   String?           // e.g. "Flash Sale", "Eid Special"
  type        CampaignType      @default(FLASH_SALE)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean           @default(true)

  items       CampaignProduct[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("campaigns")
}

enum CampaignType {
  FLASH_SALE
  FESTIVAL
  SEASONAL
  CLEARANCE
}

model CampaignProduct {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  salePrice   Decimal  @db.Decimal(10, 2)
  stockLimit  Int?     // Maximum quantity available at this discount
  soldCount   Int      @default(0)

  createdAt   DateTime @default(now())

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@map("campaign_products")
}

// ==========================================
// RATINGS & REVIEWS
// ==========================================

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation("CustomerReviews", fields: [userId], references: [id], onDelete: Cascade)

  rating             Int          // 1 to 5
  title              String?
  comment            String
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(APPROVED)

  sellerReply        String?
  sellerRepliedAt    DateTime?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([userId])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// CART
// ==========================================

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id       String @id @default(cuid())
  quantity Int

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ==========================================
// CHECKOUT GROUPS & SELLER ORDERS
// ==========================================

model OrderGroup {
  id          String @id @default(cuid())
  groupNumber String @unique

  userId String
  user   User   @relation("CustomerOrderGroups", fields: [userId], references: [id], onDelete: Restrict)

  orders Order[]

  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  currency     String  @default("BDT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("order_groups")
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  orderGroupId String
  orderGroup   OrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PENDING)

  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  currency     String  @default("BDT")

  shippingName        String
  shippingPhone       String
  shippingAddress     String
  shippingCity        String
  shippingDistrict    String?
  shippingPostalCode  String?
  shippingCountry     String  @default("Bangladesh")

  customerNote String?
  cancelledAt  DateTime?

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([orderGroupId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int

  productName            String
  productSlugAtOrder     String?
  variantLabel           String
  skuAtOrder             String?
  productImageUrlAtOrder String?

  priceAtOrder Decimal @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ==========================================
// CUSTOMER ORDER PAYMENTS
// ==========================================

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  transactionId String? @unique
  senderNumber  String?

  verifiedAt DateTime?
  verifiedBy String?
  verifier   User? @relation("PaymentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@map("payments")
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}
